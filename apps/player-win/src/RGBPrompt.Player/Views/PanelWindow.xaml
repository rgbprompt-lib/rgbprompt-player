<Window
    x:Class="RGBPrompt.Player.Views.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:RGBPrompt.Player.Views">
    <!-- Layout and metrics follow the Mac PanelRootView (PanelViews.swift):
         48 header, then the now-playing view or a state card (16 side and
         bottom padding), or the effect picker in place of both. The window
         sizes itself to this content at width 340. -->
    <Grid x:Name="RootGrid" RequestedTheme="Dark"
          AllowDrop="True" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                      IsTabStop="True" UseSystemFocusVisuals="False">
        <StackPanel x:Name="RootStack" Width="340" VerticalAlignment="Top">
            <Grid x:Name="HeaderBar" Height="48" Padding="16,0,8,0" Background="Transparent"
                  PointerPressed="HeaderBar_PointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="PanelMark" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="AppNameText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="HeaderButtons" Grid.Column="3" Orientation="Horizontal" Spacing="6"
                            Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <StackPanel x:Name="MainHost" Padding="16,0,16,16">
                <Border x:Name="HeroCard" CornerRadius="10" BorderThickness="1">
                    <Grid>
                        <views:KeyboardCanvas x:Name="HeroKeyboard" Margin="10" />
                        <Border x:Name="HeroScrim" CornerRadius="10" />
                        <StackPanel x:Name="HeroIdleHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="6">
                            <FontIcon x:Name="HeroIdleIcon" Glyph="&#xE8A5;" FontSize="13" HorizontalAlignment="Center" />
                            <TextBlock x:Name="HeroIdleText" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="HeroPreparing" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressRing Width="14" Height="14" IsActive="True" />
                            <TextBlock x:Name="HeroPreparingText" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="HeroDropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel x:Name="CardHost" />

                <StackPanel x:Name="ChipBar" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,8,0,0" Visibility="Collapsed">
                    <Border x:Name="ChipBorder" CornerRadius="11" Padding="8,0" Height="22" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <StackPanel x:Name="ChipLevels" Orientation="Horizontal" Spacing="2" Height="14"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Rectangle x:Name="ChipLevel0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="ChipLevel1" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="ChipLevel2" Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="ChipLevel3" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="ChipLevel4" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock x:Name="ChipText" VerticalAlignment="Center" />
                            <Button x:Name="ChipEnable" Style="{StaticResource FlatButton}" Padding="0"
                                    VerticalAlignment="Center" Click="ChipEnable_Click" Visibility="Collapsed">
                                <TextBlock x:Name="ChipEnableText" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid x:Name="SelectorRow" Margin="0,12,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <TextBlock x:Name="StoppedHint" TextWrapping="Wrap" Margin="2,8,2,0" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="PickerHost" Padding="8,0,8,8" Visibility="Collapsed" />

            <TextBlock x:Name="ConflictHint" TextWrapping="Wrap" Margin="16,0,16,12" Visibility="Collapsed" />
        </StackPanel>
        </ScrollViewer>
        <Border x:Name="DropOutline" BorderThickness="1.5" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>
